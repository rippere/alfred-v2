[Unit]
Description=Alfred MCP HTTP server (localhost only)
After=alfred.service
Wants=alfred.service

[Service]
Type=simple
WorkingDirectory=/home/rippere/alfred-v2
Environment="HOME=/home/rippere"
ExecStart=/home/rippere/alfred-v2/.venv/bin/python -m alfred.mcp.server_http
Restart=on-failure
RestartSec=5s
# Soft memory ceiling (throttle, not kill) — AUDIT-2026-07-13 structural #7.
# Observed MemoryPeak 84M (2026-07-13); 1G is ample for the HTTP MCP server.
MemoryHigh=1G

[Install]
WantedBy=default.target
