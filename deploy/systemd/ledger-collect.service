[Unit]
Description=Alfred life-ledger daily KPI snapshot
Documentation=file:///home/rippere/alfred-v2/deploy/systemd/INSTALL.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Collect today's snapshot and push it to NovaCRM (push degrades to a dry-run
# if ~/.config/alfred-ledger/env is missing required credentials).
ExecStart=/home/rippere/alfred-v2/.venv/bin/alfred ledger collect --push
WorkingDirectory=/home/rippere/alfred-v2
# Local timezone matters: git commit days and `created` dates are local.
Environment=TZ=America/Los_Angeles
Nice=10

[Install]
WantedBy=default.target
