[Unit]
Description=Sync Meetily meeting notes into Alfred every 15 minutes
Documentation=file:///home/rippere/alfred-v2/deploy/systemd/INSTALL.md

[Timer]
# Poll a few minutes after boot, then every 15 minutes. Meetily writes its DB
# as soon as a meeting is summarised, so a short interval keeps the vault fresh.
OnBootSec=3min
OnUnitActiveSec=15min
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
